<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Raison</title>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.0.5/dist/confetti.browser.min.js"></script>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #ffccff;
            text-align: center;
            font-family: Arial, sans-serif;
        }
        h1 {
            font-size: 50px;
            color: #ff3399;
        }
    </style>
</head>
<body>
    <h1>Happy Birthday Raison! 🎉</h1>
    <script>
        function launchConfetti() {
            confetti({
                particleCount: 100,
                spread: 160,
                origin: { y: 0.6 }
            });
        }
        setInterval(launchConfetti, 1000);
    </script>
</body>
</html>
